# MediVision AI Assistant v2.0 - Environment Configuration

# 1. Groq Multimodal API Key (Required for Llama 4 Vision & Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# 2. ElevenLabs API Key (Optional for High-Fidelity Doctor Voice, fallback to gTTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 3. MongoDB Atlas Connection URI (Optional for Cloud Diagnostic History Storage)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=medivision_db

# 4. Server Configuration
PORT=8000
CORS_ORIGINS=*
